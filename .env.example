# Base URL for general driver API endpoints (defaults to http://localhost:5000/api if not set)
VITE_API_BASE_URL=https://your-driver-api-domain.com/api

# Base URL for customer registration and OTP endpoints (defaults to https://elite.zethub.in/api if not set)
VITE_CUSTOMER_API_BASE_URL=https://your-customer-api-domain.com/api

# Base URL for admin dashboard actions (defaults to https://server.wavecabs.com/Driver/api/admin if not set)
VITE_ADMIN_API_BASE_URL=https://your-admin-api-domain.com/Driver/api/admin
